---
const a = ' = {'
const b = ' }; '
---


<section class="border rounded-2xl h-fit border-zinc-700 w-full max-w-100 relative z-40">
  <div class="w-full m flex justify-between py-2 border-b border-zinc-700 text-zinc-400 px-3">
    <h2>wilkins.js</h2>
    <span>javaScript</span>
  </div>
  <div class="w-full flex py-4">
    <span class=" text-zinc-400 px-4 items-center flex py-2">
      1<br>
      2<br>
      3<br>
      4<br>
      5<br>
      6<br>
      7<br>
    </span>
    <div class="py-2">
      <span class="text-pink-300/90 flex">
        const <p class="text-white">&nbsp;&nbsp;wilkin&nbsp;</p> 
        <span class="text-zinc-400">{a}</span>
      </span>
      <div>
        <span class="flex gap-1">
          <strong class="text-blue-500 font-medium">rol<span class="text-zinc-400">:</span></strong>
          <p class="text-green-300">"Frontend Developer"</p>
          <span class="text-zinc-400">,</span>
        </span>
        
        <span class="flex gap-1">
          <strong class="text-blue-500 font-medium">stack<span class="text-zinc-400">:</span></strong>
          <span class="text-zinc-400">[</span>
          <p class="text-green-300">"React"</p>
          <span class="text-zinc-400">,</span>
          <p class="text-green-300">"Vite"</p>
          <span class="text-zinc-400">,</span>
          <p class="text-green-300">"Tailwind"</p>
          <span class="text-zinc-400">]</span>
        </span>

        <span class="flex gap-1">
          <strong class="text-blue-500 font-medium">estado<span class="text-zinc-400">:</span></strong>
          <p class="text-green-300">"Zustand"</p>
          <span class="text-zinc-400">,</span>
        </span>
        
        <span class="flex gap-1">
          <strong class="text-blue-500 font-medium">base<span class="text-zinc-400">:</span></strong>
          <p class="text-green-300">"Republica Dominicana"</p>
          <span class="text-zinc-400">,</span>
        </span>

        <span class="flex gap-1">
          <strong class="text-blue-500 font-medium">disponible<span class="text-zinc-400">:</span></strong>
          <span class="text-yellow-400">true</span>
          <span class="text-zinc-400">,</span>
        </span>
        <span class="text-zinc-400">{b}</span>
        
      </div>
    </div>

  </div>
</section>