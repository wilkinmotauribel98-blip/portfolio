---
 
interface Props{
  title: string,
  description: string,
  number: number
}
const {title, number, description}  = Astro.props
---

<article class="bg-black rounded-xl border border-gray-800 py-5 px-7">
  <span class="text-blue-500">0{number}</span>
  <h3 class="text-white text-2xl">{title}</h3>
  <p class="text-zinc-500 text-pretty">{description}</p>
</article>